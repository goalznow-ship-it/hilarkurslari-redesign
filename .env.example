# Copy to a private, ignored .env.local. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Generate a unique random value, at least 32 characters. No default production secret.
AUTH_SECRET=""
# Canonical external origin; HTTPS is mandatory for production startup.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional only when ingress overwrites it and direct origin access is blocked.
# TRUSTED_CLIENT_IP_HEADER="x-real-ip"
# Bootstrap variables are supplied explicitly for one invocation, never default-seeded.
# BOOTSTRAP_ADMIN_EMAIL, BOOTSTRAP_ADMIN_NAME, BOOTSTRAP_ADMIN_PASSWORD

# Optional external scheduler credential; no default, use an independent random secret.
# CRON_SECRET=""
